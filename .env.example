# Copy to .env (git-ignored) or export in your shell. Never commit real values.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram group chat id the agents share (negative number for groups)
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user ids allowed to direct the agent (you + co-writers).
# Ids are permanent; usernames can change hands. Get yours from @userinfobot.
ALLOWED_USER_IDS=
# Path to the peer agent registry
PEERS_FILE=peers.json
PEER_TIMEOUT_SECONDS=120
